# --- База данных ---
DATABASE_URL="postgresql://user:password@localhost:5432/nextshop?schema=public"

# --- Платёжная система (Stripe, тестовый режим) ---
# Публичный ключ используется на клиенте для Stripe.js
STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# --- CRM (пример: amoCRM / HubSpot-совместимый webhook) ---
CRM_PROVIDER="amocrm" # amocrm | hubspot | mock
CRM_API_URL="https://example.amocrm.ru/api/v4"
CRM_API_TOKEN="crm_token_xxx"
CRM_PIPELINE_ID="1234567"

# --- Прочее ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
